generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url is configured in prisma.config.ts (Prisma 7 requirement)
}

model Hotel {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  logoUrl     String?
  themeColor  String     @default("#2563eb")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  tables      Table[]
  categories  Category[]
  feedbacks   Feedback[]
  guestSelections GuestSelection[]
  @@index([slug])
}

model Table {
  id          String   @id @default(uuid())
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  tableNumber String
  qrCodeUrl   String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  @@unique([hotelId, tableNumber])
  @@index([hotelId])
}

model Category {
  id           String     @id @default(uuid())
  hotelId      String
  hotel        Hotel      @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name         String
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())
  items        MenuItem[]
  @@index([hotelId])
  @@index([hotelId, displayOrder])
}

model MenuItem {
  id            String     @id @default(uuid())
  categoryId    String
  category      Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name          String
  description   String     @db.Text
  price         Decimal    @db.Decimal(10, 2)
  priceUsd      Decimal?   @db.Decimal(10, 2)
  prepTimeMins  Int        @default(0)
  imageUrl      String?
  isAvailable   Boolean    @default(true)
  dietaryTags   String[]
  displayOrder  Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  @@index([categoryId])
  @@index([categoryId, isAvailable])
  @@index([categoryId, displayOrder])
}

model Feedback {
  id        String   @id @default(uuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name      String?
  message   String   @db.Text
  rating    Int?
  createdAt DateTime @default(now())
  @@index([hotelId, createdAt])
}

model GuestSelection {
  id          String                @id @default(uuid())
  hotelId     String
  hotel       Hotel                 @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  guestToken  String
  isDismissed Boolean               @default(false)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  items       GuestSelectionItem[]
  @@unique([hotelId, guestToken])
  @@index([hotelId, updatedAt])
}

model GuestSelectionItem {
  id            String         @id @default(uuid())
  selectionId   String
  selection     GuestSelection @relation(fields: [selectionId], references: [id], onDelete: Cascade)
  menuItemId    String
  name          String
  categoryName  String
  quantity      Int
  unitPrice     Decimal        @db.Decimal(10, 2)
  unitPriceUsd  Decimal?       @db.Decimal(10, 2)
  updatedAt     DateTime       @updatedAt
  @@unique([selectionId, menuItemId])
  @@index([selectionId])
}

// Failed admin login attempts, keyed by a hash of the client IP, used to slow down
// password guessing. Rows are removed on successful login or when they go stale.
model AdminLoginAttempt {
  key         String    @id
  failures    Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
  @@index([windowStart])
}

model MenuSettings {
  id                       String   @id @default("global")
  languageSwitcherEnabled  Boolean  @default(false)
  newestDishesFirst        Boolean  @default(false)
  updatedAt                DateTime @updatedAt
}
